# CFG-01: environment for docker-compose on the server. Copy to .env (never commit .env),
# fill every value, keep the file readable only by the deploy user (chmod 600).
# All values below are placeholders - none of them works as-is.

# PostgreSQL password for auto_auction_user (generate: openssl rand -base64 32)
DB_PASSWORD=change-me

# JWT signing secret, at least 32 bytes (generate: openssl rand -hex 32).
# The prod profile refuses short or publicly known values.
JWT_SECRET=change-me

# Production SPA origin(s), comma-separated, https only (no localhost, no wildcard)
ALLOWED_ORIGINS=https://your-domain.example

# Public URL under which /uploads is served, https only
MEDIA_BASE_URL=https://your-domain.example/uploads

# Cloudflare R2 (private media bucket, least-privilege key - see S3-02/S3-03)
R2_ACCOUNT_ID=change-me
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
